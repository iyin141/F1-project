# Copy to .env and fill in. Never commit .env.
# Redis URLs are set by docker-compose.yml; don't set REDIS_*_URL here.

# --- Django ---
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=api.f1controlroomdocs.com,localhost,127.0.0.1,web
SITE_BASE_URL=https://api.f1controlroomdocs.com

# --- Database (Neon in production) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Email ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Internal / admin keys ---
ADMIN_SECRET=
INTERNAL_API_KEY=
INTERNAL_KEY_PASSWORD=
INTERNAL_KEY_PATH=

# --- Optional outbound proxy for FastF1 / Jolpica ---
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# --- Test switches (leave empty in production) ---
USE_FAKE_FASTF1=
USE_FAKE_JOLPICA=
RUN_INTEGRATION_TESTS=
