# Copy to .env and fill in. Never commit .env.
# Redis URLs are set by docker-compose.yml; don't set REDIS_*_URL here.

# --- Django ---
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=api.f1controlroomdocs.com,localhost,127.0.0.1,web
SITE_BASE_URL=https://api.f1controlroomdocs.com

# --- Database: Postgres runs INSIDE the stack (service `postgres`, pgvector image) ---
# Use a URL-safe password (it is embedded in DATABASE_URL): openssl rand -hex 24
# DATABASE_URL is built by docker-compose.yml from these three; do not set it here.
POSTGRES_PASSWORD=change-me
POSTGRES_USER=f1
POSTGRES_DB=f1
# Scheduled pg_dump sidecar (service `pgbackup`) -> volume pg_backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
# One-off Neon -> stack copy (make migrate-from-neon). Leave empty otherwise; read-only use, see deploy/RUNBOOK_DB.md
NEON_DATABASE_URL=

# --- Email ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Internal / admin keys ---
ADMIN_SECRET=
INTERNAL_API_KEY=
INTERNAL_KEY_PASSWORD=
INTERNAL_KEY_PATH=

# --- Optional outbound proxy for FastF1 / Jolpica ---
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# --- Test switches (leave empty in production) ---
USE_FAKE_FASTF1=
USE_FAKE_JOLPICA=
RUN_INTEGRATION_TESTS=

# --- Claude CLI (Stewards): host dir holding the logged-in ~/.claude, mounted into web + worker-rag.
# Must be owned by uid 1000 (the image user). Log in once on the host with `claude`.
CLAUDE_CONFIG_DIR=/home/ubuntu/.claude
